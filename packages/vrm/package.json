{
  "name": "@starcried/starlite-vrm",
  "version": "0.1.0-alpha.3",
  "type": "module",
  "license": "BSD-2-Clause",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "DEFAULT_IDLE.md",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    },
    "./inspect": {
      "types": "./dist/inspect.d.ts",
      "import": "./dist/inspect.js",
      "require": "./dist/inspect.cjs"
    },
    "./widget.css": "./dist/widget.css",
    "./prepare": {
      "types": "./dist/prepare.d.ts",
      "default": "./dist/prepare.cjs"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "@pixiv/three-vrm-animation": "3.5.5",
    "@starcried/starlite-core": "0.1.0-alpha.3",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/three": "0.183.1",
    "esbuild": "0.28.2"
  },
  "description": "WebGL2 VRM and VRMA backend for lightweight StarLite companions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StarCried/starlite.git",
    "directory": "packages/vrm"
  },
  "homepage": "https://github.com/StarCried/starlite#readme",
  "bugs": "https://github.com/StarCried/starlite/issues"
}
