{
  "name": "inochi2d-web",
  "version": "0.1.0-alpha.1",
  "description": "Framework-free Inochi2D WebGL2 widget runtime",
  "type": "module",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StarCried/inochi2d-web.git",
    "directory": "packages/inochi2d-web"
  },
  "homepage": "https://github.com/StarCried/inochi2d-web#readme",
  "bugs": "https://github.com/StarCried/inochi2d-web/issues",
  "sideEffects": [
    "./dist/widget.css"
  ],
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./widget.css": "./dist/widget.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  }
}
